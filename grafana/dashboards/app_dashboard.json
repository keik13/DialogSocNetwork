{
  "id": null,
  "uid": "app-dashboard",
  "title": "App Dashboard",
  "timezone": "UTC",
  "schemaVersion": 16,
  "version": 3,
  "panels": [
    {
      "type": "graph",
      "title": "HTTP Requests Total (Rate)",
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[1m])) by (path)",
          "legendFormat": "{{path}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      },
      "lines": true,
      "legend": {
        "show": true,
        "alignAsTable": true,
        "rightSide": true
      },
      "tooltip": {
        "shared": true
      }
    },
    {
      "type": "graph",
      "title": "Request Duration (Percentiles)",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "50th percentile",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.90, sum(rate(request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "90th percentile",
          "refId": "C"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "99th percentile",
          "refId": "D"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 10
      },
      "lines": true,
      "legend": {
        "show": true,
        "alignAsTable": true,
        "rightSide": true
      },
      "tooltip": {
        "shared": true
      },
      "xaxis": {
        "mode": "time"
      },
      "yaxis": {
        "label": "Duration (seconds)"
      }
    }
  ]
}
